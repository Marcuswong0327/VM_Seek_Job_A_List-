{
  "name": "vm-seek-job-a-list",
  "version": "0.1.0",
  "private": true,
  "description": "Sequential Seek job listing scraper for local test and GCP VM",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
